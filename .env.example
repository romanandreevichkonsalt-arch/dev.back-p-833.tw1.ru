# Копировать на сервер как app/<domain>/.env (chmod 600). Не коммитить.
#
# Staging:  .../app/api.dev-fabrika.ru/.env
# Production: .../app/api.mf-anna.ru/.env

# --- Staging (api.dev-fabrika.ru): test_ ключ, shop 1470173, все чеки на YOOKASSA_RECEIPT_EMAIL ---
# --- Production (api.mf-anna.ru): live_ ключ, YOOKASSA_RECEIPT_EMAIL пустой, YOOKASSA_SEND_RECEIPT=1 ---
# DB_DSN=mysql:host=localhost;dbname=api_dev_fabr
# DB_USER=api_dev_fabr
# DB_PASSWORD=
# FRONTEND_URL=https://dev-fabrika.ru
# YOOKASSA_RETURN_URL=https://dev-fabrika.ru/cart?fromPayment=1
# YOOKASSA_RECEIPT_FALLBACK_EMAIL_DOMAIN=noreply.dev-fabrika.ru

# --- Production (api.mf-anna.ru · фронт https://mf-anna.ru) ---
# DB_DSN=mysql:host=localhost;dbname=api_mf_anna_
# DB_USER=api_mf_anna_
# DB_PASSWORD=
# FRONTEND_URL=https://mf-anna.ru
# YOOKASSA_RETURN_URL=https://mf-anna.ru/cart?fromPayment=1
# YOOKASSA_RECEIPT_FALLBACK_EMAIL_DOMAIN=noreply.mf-anna.ru

DB_DSN=mysql:host=localhost;dbname=api_dev_fabr
DB_USER=api_dev_fabr
DB_PASSWORD=

# Публичный URL фронта (CORS, ссылки в письмах, YooKassa return, ЛК дилера: {FRONTEND_URL}/dealer)
FRONTEND_URL=https://dev-fabrika.ru
# Опционально полный URL ЛК дилера (иначе FRONTEND_URL + /dealer)
# DEALER_CABINET_URL=https://mf-anna.ru/dealer
# Доп. origin для CORS через запятую (опционально)
# CORS_ORIGINS=https://staging.example.com

# YooKassa (production — боевые ключи; на staging — тест или пусто)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт покупателя после оплаты (фронт, не API). К заказу допишется &number=ORD-…
YOOKASSA_RETURN_URL=https://dev-fabrika.ru/cart?fromPayment=1
# Оставьте пустым на prod — чек уходит на email покупателя из заказа. Заполните только для отладки (все чеки на один ящик).
YOOKASSA_RECEIPT_EMAIL=
# Если в заказе нет email — guest+7XXXXXXXXXX@этот-домен (не «настоящая» почта клиента).
YOOKASSA_RECEIPT_FALLBACK_EMAIL_DOMAIN=noreply.dev-fabrika.ru
# 1 — прикладывать receipt к платежу (54-ФЗ). На prod обычно 1, даже если RECEIPT_EMAIL пуст.
# YOOKASSA_SEND_RECEIPT=1

DADATA_API_KEY=
DADATA_SECRET_KEY=

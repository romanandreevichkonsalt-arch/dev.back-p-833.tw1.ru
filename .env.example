# Копировать на сервер: .../app/api.dev-fabrika.ru/.env (chmod 600). Не коммитить.

DB_DSN=mysql:host=localhost;dbname=api_dev_fabr
DB_USER=api_dev_fabr
DB_PASSWORD=

# Публичный URL фронта (CORS, ссылки в письмах, YooKassa return)
FRONTEND_URL=https://dev-fabrika.ru
# Доп. origin для CORS через запятую (опционально)
# CORS_ORIGINS=https://staging.example.com

# YooKassa (prod — боевые ключи; на dev можно оставить пустым)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa вернёт покупателя после оплаты (фронт, не API). К заказу допишется &number=ORD-…
YOOKASSA_RETURN_URL=https://dev-fabrika.ru/cart?fromPayment=1
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_RECEIPT_FALLBACK_EMAIL_DOMAIN=noreply.dev-fabrika.ru

DADATA_API_KEY=
DADATA_SECRET_KEY=
